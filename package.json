{
  "name": "retailpulse-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --watch src/main.mjs",
    "start": "node src/main.mjs",
    "test": "node --test",
    "test:cov": "c8 --all --include=src/api-server.mjs --include=src/api-routes.mjs --include=src/http-utils.mjs --include=src/model.mjs --include=src/analytics.repository.mjs --include=src/analytics.metrics.mjs --include=src/analytics.query.mjs --include=src/analytics.seed.mjs --exclude=src/**/*.test.mjs --reporter=text --check-coverage --lines=90 --statements=90 --functions=90 --branches=90 node --test",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write 'src/**/*.mjs' '.github/workflows/*.yml' 'package.json'",
    "format:check": "prettier --check 'src/**/*.mjs' '.github/workflows/*.yml' 'package.json'",
    "check": "node --check src/main.mjs && node --check src/server.mjs && node --check src/api-server.mjs && node --check src/api-routes.mjs && node --check src/http-utils.mjs && node --check src/model.mjs && node --check src/analytics.repository.mjs && node --check src/analytics.metrics.mjs && node --check src/analytics.query.mjs && node --check src/analytics.seed.mjs"
  },
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "c8": "^12.0.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
